#include <iostream>
#include <vector>
#include <functional>

using namespace std;

int addOne(int x)
{
    return x + 1;
}

int doubleNumber(int x)
{
    return x * 2;
}

int square(int x)
{
    return x * x;
}

int main()
{
    vector<function<int(int)>> operations = {
        addOne,
        doubleNumber,
        square
    };

    int number = 10;

    for (const auto& operation : operations)
    {
        cout << operation(number) << endl;
    }

    return 0;
}

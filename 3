#include <iostream>
#include <functional>

using namespace std;

int square(int x)
{
    return x * x;
}

int doubleNumber(int x)
{
    return x * 2;
}

int apply(function<int(int)> func, int x)
{
    return func(x);
}

int main()
{
    cout << apply(square, 5) << endl;

    cout << apply(doubleNumber, 5) << endl;

    return 0;
}

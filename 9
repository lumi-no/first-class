#include <iostream>
#include <vector>
#include <map>
#include <functional>
#include <algorithm>

using namespace std;

vector<int> sortAsc(vector<int> data)
{
    sort(data.begin(), data.end());

    return data;
}

vector<int> sortDesc(vector<int> data)
{
    sort(data.rbegin(), data.rend());

    return data;
}

int main()
{
    vector<int> numbers = {5, 1, 4, 2, 3};

    map<string, function<vector<int>(vector<int>)>> strategies =
    {
        {"asc", sortAsc},
        {"desc", sortDesc}
    };

    vector<int> result = strategies["asc"](numbers);

    for (int x : result)
    {
        cout << x << " ";
    }

    return 0;
}
